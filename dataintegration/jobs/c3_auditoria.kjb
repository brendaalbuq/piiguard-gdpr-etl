      <name>Abrir auditorias</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO auditoria.execucao (empresa_id, percentagem_amostra)
SELECT empresa_id, ${PCT} FROM ref.empresa;</sql>
