      <attributes_kjc/>
    </entry>
    <entry>
      <name>Contar e criar notificacoes</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>WITH totais AS (
  SELECT e.auditoria_id,
         (SELECT count(*) FROM auditoria.ticket t WHERE t.empresa_id = e.empresa_id)
       + (SELECT count(*) FROM clean.cliente c WHERE c.empresa_id = e.empresa_id AND c.data_fim IS NULL)
       + (SELECT count(*) FROM clean.fatura f WHERE f.empresa_id = e.empresa_id) AS total_registos,
         (SELECT count(*) FROM auditoria.amostra a WHERE a.auditoria_id = e.auditoria_id AND a.selecionado) AS registos_amostra
  FROM auditoria.execucao e
  WHERE e.total_registos IS NULL
)
UPDATE auditoria.execucao e
SET total_registos = t.total_registos,
    registos_amostra = t.registos_amostra,
    percentagem_observada = CASE WHEN t.total_registos = 0 THEN NULL
      ELSE round(100.0 * t.registos_amostra / t.total_registos, 2) END,
    total_constatacoes = (SELECT count(*) FROM auditoria.constatacao c WHERE c.auditoria_id = e.auditoria_id)
FROM totais t
WHERE e.auditoria_id = t.auditoria_id;
INSERT INTO auditoria.notificacao (auditoria_id, empresa_id, email_destino)
SELECT e.auditoria_id, e.empresa_id, r.email_contacto
FROM auditoria.execucao e JOIN ref.empresa r ON r.empresa_id = e.empresa_id
WHERE e.auditoria_id IN (SELECT max(auditoria_id) FROM auditoria.execucao GROUP BY empresa_id)
  AND e.total_constatacoes > 0
  AND NOT EXISTS (SELECT 1 FROM auditoria.notificacao n WHERE n.auditoria_id = e.auditoria_id);</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>piiguard_db</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>460</xloc>
      <yloc>160</yloc>
      <attributes_kjc/>
    </entry>
