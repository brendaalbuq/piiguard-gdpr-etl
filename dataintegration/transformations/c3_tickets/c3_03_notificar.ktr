  <step>
    <name>Montar email</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var assunto = "Auditoria RGPD [" + auditoria_id + "] - " + empresa + " - " + data_auditoria;
var corpo = "&lt;html>&lt;body style='font-family:Segoe UI,Arial,sans-serif'>" +
  "&lt;h2 style='color:#0e3a5a'>Resultado da auditoria de dados pessoais&lt;/h2>" +
  "&lt;p>Exmos. Senhores da &lt;b>" + empresa + "&lt;/b>,&lt;/p>" +
  "&lt;p>Na auditoria de " + data_auditoria + " foram analisados por amostragem &lt;b>" + registos_amostra + "&lt;/b> de " + total_registos +
  " registos. Percentagem pedida: " + percentagem_amostra + "%; percentagem observada: " + (percentagem_observada == null ? "n/a" : percentagem_observada + "%") + ". Foram identificadas &lt;b>" + total_constatacoes + "&lt;/b> situações de dados pessoais mal armazenados:&lt;/p>" +
  "&lt;ul>" + (lista == null ? "&lt;li>Sem constatações&lt;/li>" : lista) + "&lt;/ul>" +
  "&lt;p>Os detalhes estão disponíveis na base de dados de auditoria (auditoria.constatacao, auditoria n.º " + auditoria_id + ").&lt;/p>" +
  "&lt;p style='color:#52606d;font-size:12px'>Este email não contém dados pessoais: os valores encontrados estão mascarados na base de auditoria.&lt;/p>" +
  "&lt;p>PiiGuard - Auditoria RGPD&lt;/p>&lt;/body>&lt;/html>";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>assunto</name>
        <rename>assunto</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>corpo</name>
        <rename>corpo</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>448</xloc>
      <yloc>138</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Notificacoes pendentes</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>piiguard_db</connection>
    <sql>SELECT n.notificacao_id, n.email_destino, r.nome AS empresa, e.auditoria_id,
       to_char(e.executada_em, 'DD/MM/YYYY HH24:MI') AS data_auditoria, e.percentagem_amostra,
       e.percentagem_observada, e.total_registos, e.registos_amostra, e.total_constatacoes,
       (SELECT string_agg('&lt;li>' || x.regra || ' (gravidade ' || x.gravidade || '): ' || x.n || '&lt;/li>', '' ORDER BY x.gravidade, x.regra)
          FROM (SELECT c.regra, c.gravidade, count(*) AS n
                  FROM auditoria.constatacao c
                 WHERE c.auditoria_id = e.auditoria_id OR (c.auditoria_id IS NULL AND c.empresa_id = e.empresa_id)
                 GROUP BY c.regra, c.gravidade) x) AS lista
FROM auditoria.notificacao n
JOIN auditoria.execucao e ON e.auditoria_id = n.auditoria_id
JOIN ref.empresa r ON r.empresa_id = n.empresa_id
WHERE n.estado IN ('PENDENTE', 'FALHOU') AND n.tentativas &lt; 3
ORDER BY n.notificacao_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>128</xloc>
      <yloc>138</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
    <error>
      <source_step>Enviar email a empresa</source_step>
      <target_step>Marcar FALHOU</target_step>
      <is_enabled>Y</is_enabled>
      <nr_valuename/>
      <descriptions_valuename>erro_email</descriptions_valuename>
      <fields_valuename/>
      <codes_valuename/>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </step_error_handling>
