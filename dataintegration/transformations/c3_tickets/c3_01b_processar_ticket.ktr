        <jsScript_script>// Mensagem JSON para o dashboard (só com o texto JÁ mascarado)
function q(v) { return v == null ? "null" : '"' + String(v).replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"'; }
var alerta = "{" +
  '"ticket_id":' + q(ticket_id) + "," +
  '"empresa":' + q(empresa) + "," +
  '"canal":' + q(canal) + "," +
  '"tipos_pii":' + q(tipos_pii) + "," +
  '"gravidade":' + q(gravidade) + "," +
  '"mensagem_mascarada":' + q(texto_mascarado) + "," +
  '"recebido_em":' + q(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date())) +
  "}";</jsScript_script>
