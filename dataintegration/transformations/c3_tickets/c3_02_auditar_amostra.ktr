    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var regra;
var detalhe;
if (circuito == "C2") {
  // Fatura da amostra cujo cliente não existe no CRM (não é texto livre)
  regra = "CLIENTE_SEM_CRM";
  detalhe = "Fatura da amostra emitida a um cliente que não existe no CRM da empresa (NIF guardado só como hash)";
} else {
  regra = String(tipos_pii).indexOf("DADO_SAUDE") >= 0 ? "DADO_SAUDE_EM_TEXTO_LIVRE" : "PII_EM_TEXTO_LIVRE";
  detalhe = (circuito == "C3" ? "Ticket de suporte" : "Observações do cliente") + " com " + tipos_pii +
            " guardado(s) em texto livre (valor já mascarado na base de auditoria)";
}</jsScript_script>
      </jsScript>
    </jsScripts>
