    <connection>piiguard_db</connection>
    <sql>SELECT 'C3' AS circuito, empresa_id, ticket_id AS referencia, tipos_pii, gravidade FROM auditoria.ticket
UNION ALL
SELECT 'C1', empresa_id, cliente_sk::text, tipos_pii, gravidade FROM clean.cliente WHERE data_fim IS NULL
UNION ALL
SELECT 'C2', empresa_id, invoice_no AS referencia,
       CASE WHEN cliente_sk IS NULL THEN 'CLIENTE_SEM_CRM' ELSE NULL END AS tipos_pii,
       CASE WHEN cliente_sk IS NULL THEN 'MEDIA' ELSE NULL END AS gravidade
FROM clean.fatura</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
