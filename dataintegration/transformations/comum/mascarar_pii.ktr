  <step>
    <name>Classificar PII e gravidade</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Que marcas ficaram no texto? Cada marca corresponde a um tipo de dado pessoal.
var t = (texto_mascarado == null) ? "" : String(texto_mascarado);
var marcas = ["EMAIL", "IBAN", "CC", "TELEFONE", "NIF", "CODIGO_POSTAL", "MORADA", "DADO_SAUDE"];
var lista = [];
for (var i = 0; i &lt; marcas.length; i++) {
  if (t.indexOf("[" + marcas[i] + "]") >= 0) lista.push(marcas[i]);
}
var tipos_pii = lista.length > 0 ? lista.join(",") : null;
var tem_pii = lista.length > 0;
var gravidade = null;
if (tem_pii) {
  if (lista.indexOf("DADO_SAUDE") >= 0 || lista.indexOf("IBAN") >= 0 || lista.indexOf("CC") >= 0) gravidade = "ALTA";
  else if (lista.indexOf("NIF") >= 0 || lista.indexOf("MORADA") >= 0) gravidade = "MEDIA";
  else gravidade = "BAIXA";
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>tipos_pii</name>
        <rename>tipos_pii</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>tem_pii</name>
        <rename>tem_pii</rename>
        <type>Boolean</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>gravidade</name>
        <rename>gravidade</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>2336</xloc>
      <yloc>138</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Mascarar CC (regex)</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>texto_mascarado</in_stream_name>
        <out_stream_name/>
        <use_regex>yes</use_regex>
        <replace_string>\b\d{8}\s?\d\s?[A-Z]{2}\d\b</replace_string>
        <replace_by_string>[CC]</replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>no</whole_word>
        <case_sensitive>no</case_sensitive>
        <is_unicode>no</is_unicode>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>896</xloc>
      <yloc>138</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Mascarar CODIGO_POSTAL (regex)</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>texto_mascarado</in_stream_name>
        <out_stream_name/>
        <use_regex>yes</use_regex>
        <replace_string>\b\d{4}-\d{3}\b</replace_string>
        <replace_by_string>[CODIGO_POSTAL]</replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>no</whole_word>
        <case_sensitive>no</case_sensitive>
        <is_unicode>no</is_unicode>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1616</xloc>
      <yloc>252</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Mascarar DADO_SAUDE (regex)</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>texto_mascarado</in_stream_name>
        <out_stream_name/>
        <use_regex>yes</use_regex>
        <replace_string>\b(diabetes|alergia|al[eé]rgic[oa]|penicilina|anticoagulantes?|ficha cl[ií]nica|asma|hipertens\w*|gr[aá]vida)\b</replace_string>
        <replace_by_string>[DADO_SAUDE]</replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>no</whole_word>
        <case_sensitive>no</case_sensitive>
        <is_unicode>no</is_unicode>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>2096</xloc>
      <yloc>252</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Mascarar EMAIL (regex)</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>texto</in_stream_name>
        <out_stream_name>texto_mascarado</out_stream_name>
        <use_regex>yes</use_regex>
        <replace_string>[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+</replace_string>
        <replace_by_string>[EMAIL]</replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>no</whole_word>
