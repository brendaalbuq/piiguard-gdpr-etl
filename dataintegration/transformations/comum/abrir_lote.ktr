      <from>Criar lote (INSERT ... RETURNING)</from>
      <to>Guardar LOTE_ID</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Criar lote (INSERT ... RETURNING)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>piiguard_db</connection>
    <sql>INSERT INTO controlo.lote (circuito, ficheiro_origem)
VALUES ('${CIRCUITO}', '${FICHEIRO}')
RETURNING lote_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
