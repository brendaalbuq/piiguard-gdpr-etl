<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>abrir_lote</name>
    <description>Cria um lote em controlo.lote e guarda o seu número na variável LOTE_ID (válida para o Job inteiro).</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>CIRCUITO</name>
        <default_value>C1</default_value>
        <description>Circuito que abre o lote (C1, C2)</description>
      </parameter>
      <parameter>
        <name>FICHEIRO</name>
        <default_value/>
        <description>Ficheiro(s) de origem do lote</description>
      </parameter>
    </parameters>
