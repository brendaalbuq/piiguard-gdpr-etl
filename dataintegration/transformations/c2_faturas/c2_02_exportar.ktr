  <step>
    <name>Faturas do lote</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>piiguard_db</connection>
    <sql>SELECT f.invoice_no, to_char(f.invoice_date, 'YYYY-MM-DD') AS data, to_char(f.invoice_date, 'YYYY-MM') AS mes,
       e.nome AS empresa, f.cliente_nif_hash, f.cidade, f.net_total, f.tax_payable, f.gross_total,
       CASE WHEN f.cliente_sk IS NULL THEN 'N' ELSE 'S' END AS cliente_no_crm
FROM clean.fatura f JOIN ref.empresa e USING (empresa_id)
WHERE f.lote_id = ${LOTE_ID}
ORDER BY f.invoice_no</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
