<?xml version="1.0" encoding="UTF-8"?>
<!--
  PiiGuard - XSD do SAF-T simplificado (Circuito 2).
  Versão reduzida do SAF-T (PT) oficial, só com os campos usados no trabalho.
  Regras que interessam ao RGPD e à qualidade dos dados:
    - NIF (CustomerTaxID / TaxRegistrationNumber): exatamente 9 dígitos
    - Código postal português: 4 dígitos, hífen, 3 dígitos
    - InvoiceDate: tem de ser xs:date (aaaa-mm-dd)
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="NIF">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{9}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CodigoPostal">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}-[0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Montante">
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="2"/>
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="AuditFile">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Header">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="CompanyID" type="NIF"/>
              <xs:element name="TaxRegistrationNumber" type="NIF"/>
              <xs:element name="CompanyName" type="xs:string"/>
              <xs:element name="FiscalYear" type="xs:gYear"/>
              <xs:element name="StartDate" type="xs:date"/>
              <xs:element name="EndDate" type="xs:date"/>
              <xs:element name="CurrencyCode" type="xs:string" fixed="EUR"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="MasterFiles">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Customer" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="CustomerID" type="xs:string"/>
                    <xs:element name="CustomerTaxID" type="NIF"/>
                    <xs:element name="CompanyName" type="xs:string"/>
                    <xs:element name="BillingAddress">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="AddressDetail" type="xs:string"/>
                          <xs:element name="City" type="xs:string"/>
                          <xs:element name="PostalCode" type="CodigoPostal"/>
                          <xs:element name="Country" type="xs:string"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Telephone" type="xs:string" minOccurs="0"/>
                    <xs:element name="Email" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="SourceDocuments">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="SalesInvoices">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Invoice" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="InvoiceNo" type="xs:string"/>
                          <xs:element name="InvoiceDate" type="xs:date"/>
                          <xs:element name="CustomerID" type="xs:string"/>
                          <xs:element name="Line" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="LineNumber" type="xs:positiveInteger"/>
                                <xs:element name="ProductCode" type="xs:string"/>
                                <xs:element name="ProductDescription" type="xs:string"/>
                                <xs:element name="Quantity" type="xs:decimal"/>
                                <xs:element name="UnitPrice" type="Montante"/>
                                <xs:element name="CreditAmount" type="Montante"/>
                                <xs:element name="TaxPercentage" type="xs:decimal"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="DocumentTotals">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="NetTotal" type="Montante"/>
                                <xs:element name="TaxPayable" type="Montante"/>
                                <xs:element name="GrossTotal" type="Montante"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
